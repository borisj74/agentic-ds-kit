{
  "name": "kit-sandbox",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/kit"
  ],
  "scripts": {
    "generate:tokens": "npm run generate:tokens -w agentic-ds-kit",
    "dev": "next dev --hostname 0.0.0.0 --port 43123",
    "build": "npm run generate:tokens && next build",
    "start": "next start --hostname 0.0.0.0 --port 43123",
    "lint": "eslint"
  },
  "dependencies": {
    "agentic-ds-kit": "*",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5"
  }
}
