{
  "name": "agentic-ds-kit",
  "version": "0.20.0",
  "description": "Code-only agentic design system: contracts, tokens, React components, and a local MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisj74/agentic-ds-kit.git",
    "directory": "packages/kit"
  },
  "homepage": "https://agentic-ds-kit.vercel.app",
  "bugs": {
    "url": "https://github.com/borisj74/agentic-ds-kit/issues"
  },
  "type": "module",
  "bin": {
    "agentic-ds-kit": "./bin/agentic-ds-kit.mjs"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.module.js",
    "./src/tokens.ts",
    "./src/layout.ts",
    "./dist/src/tokens.js",
    "./dist/src/layout.js",
    "./src/icons-on-demand.ts",
    "./dist/src/icons-on-demand.js"
  ],
  "files": [
    "dist",
    "bin",
    "patterns-src",
    "contracts",
    "tokens",
    "lib",
    "skills",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./icons-on-demand": {
      "types": "./dist/src/icons-on-demand.d.ts",
      "import": "./dist/src/icons-on-demand.js",
      "default": "./dist/src/icons-on-demand.js"
    },
    "./tokens.css": "./lib/tokens.css",
    "./layout.css": "./lib/layout.css",
    "./contracts/index.json": "./contracts/index.json",
    "./contracts/*.json": "./contracts/*.json",
    "./contracts/patterns/*.json": "./contracts/patterns/*.json",
    "./tokens/tokens.json": "./tokens/tokens.json",
    "./tokens/usage.json": "./tokens/usage.json",
    "./color-ramp": {
      "types": "./lib/color-ramp.d.ts",
      "import": "./lib/color-ramp.mjs",
      "default": "./lib/color-ramp.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "build:patterns-src": "node scripts/build-patterns-src.mjs",
    "sync:index": "node scripts/sync-index-intents.mjs",
    "build": "npm run generate:tokens && npm run sync:index && vite build && npm run build:patterns-src",
    "version": "node ../../scripts/sync-kit-version-docs.mjs",
    "prepublishOnly": "npm run build",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "peerDependencies": {
    "next": ">=15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "30.1.3",
    "rollup-preserve-directives": "^1.1.3",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
