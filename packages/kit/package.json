{
  "name": "agentic-ds-kit",
  "version": "0.2.8",
  "description": "Code-only agentic design system: contracts, tokens, and React components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/borisj74/agentic-ds-kit.git",
    "directory": "packages/kit"
  },
  "homepage": "https://github.com/borisj74/agentic-ds-kit#readme",
  "bugs": {
    "url": "https://github.com/borisj74/agentic-ds-kit/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.module.js",
    "./src/tokens.ts",
    "./src/layout.ts",
    "./dist/src/tokens.js",
    "./dist/src/layout.js"
  ],
  "files": [
    "dist",
    "contracts",
    "tokens",
    "lib",
    "skills",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./tokens.css": "./lib/tokens.css",
    "./layout.css": "./lib/layout.css",
    "./contracts/index.json": "./contracts/index.json",
    "./contracts/*.json": "./contracts/*.json",
    "./contracts/patterns/*.json": "./contracts/patterns/*.json",
    "./tokens/tokens.json": "./tokens/tokens.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "generate:tokens": "node scripts/generate-tokens.mjs",
    "build": "npm run generate:tokens && vite build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "next": ">=14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.37.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "rollup-preserve-directives": "^1.1.3",
    "typescript": "^5",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
