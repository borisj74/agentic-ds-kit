{
  "id": "shimmertext",
  "status": "stable",
  "level": "atom",
  "intent": "Animated text for short indeterminate processing copy.",
  "useWhen": [
    "Generating or loading message placeholders",
    "Swap to real content when ready"
  ],
  "doNotUseWhen": [
    "Static headings or body copy",
    "Long paragraphs of final content"
  ],
  "props": {
    "style": {"type": "object", "required": false, "note": "Inline style on the root span, merged with the kit's --shimmer-duration-factor variable."},
    "children": { "type": "string", "required": true },
    "size": {
      "type": "enum",
      "values": ["sm", "md", "lg"],
      "default": "md"
    },
    "speed": {
      "type": "enum|number",
      "values": ["slow", "normal", "fast"],
      "default": "normal"
    }
  },
  "passthrough": {
    "root": "span",
    "ref": "span",
    "className": "root",
    "rest": "span"
  },
  "tokens": ["text.primary", "text.muted"],
  "a11y": {
    "element": "span",
    "requirements": ["Visually hidden text carries the text; the animated characters are aria-hidden. No aria-label on the span", "Respect prefers-reduced-motion"]
  },
  "doNot": ["Do not use raw hex"],
  "snippet": "<ShimmerText speed=\"normal\">Generating response…</ShimmerText>"
}
